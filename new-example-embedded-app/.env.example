# Prismatic embedded — dev-only configuration.
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored. Never commit a signing key.

# ==== Embedded JWT =====================================================
# Values here are consumed by `src/plugins/prismatic-auth.ts` to generate
# embedded JWTs for the Prismatic Embedded SDK

# The Prismatic API host for your region.
PRISMATIC_URL=https://app.prismatic.io

# Your organization ID, from Prismatic. This will start with `T3J...`
PRISMATIC_ORGANIZATION=""

# The customer this user belongs to (its external ID you set).
PRISMATIC_CUSTOMER_EXTERNAL_ID=abc-123

# The end user. Must be unique and stable for each user.
# This is generally a UUID or similar and is used for the `sub`
# and `external_id` claims in the JWT.
PRISMATIC_USER_ID=""

# Path to the RSA private key that pairs with the public key you uploaded to
# Prismatic. The path is relative to this directory.
PRISMATIC_SIGNING_KEY_PATH=./prismatic-private-key.pem

# The display name of the user and of the customer. (e.g. Jane Doe at Acme Corp)
PRISMATIC_USER_NAME="Jane Doe"
PRISMATIC_CUSTOMER_NAME="Acme Corp"

# "admin" grants marketplace administration rights. "user" is only used for user-level config
PRISMATIC_ROLE=admin

# Token lifetime in seconds. This example app automatically refreshes tokens
# 30 seconds before they expire. The minimum is 120.
PRISMATIC_TOKEN_VALID_SECONDS=3600

# ==== AI SDK ============================================================
# Values here are consumed by `src/plugins/acme-chat.ts` for chatbot communication

# We use OpenAI for this example, but you can modify `acme-chat.ts` to use a different AI provider if desired.
# This will likely start with `sk-proj-`
OPENAI_API_KEY=""

# Update the Prismatic MCP Flow server URL if you do not use the commercial US stack
# See https://prismatic.io/docs/ai/mcp-endpoints/
PRISMATIC_MCP_URL="https://mcp.prismatic.io/mcp"