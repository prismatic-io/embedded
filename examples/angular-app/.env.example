# Copy to .env.local. Bun loads it when it starts server.ts.

# The Prismatic API host for your region.
PRISMATIC_URL=https://app.prismatic.io
# Your organization ID. It starts with `T3J...`
PRISMATIC_ORGANIZATION=
# The external ID of the customer the user belongs to.
PRISMATIC_CUSTOMER_EXTERNAL_ID=abc-123
PRISMATIC_CUSTOMER_NAME="Acme Corp"
# A unique, stable ID for the end user.
PRISMATIC_USER_ID=
PRISMATIC_USER_NAME="Jane Doe"
# "admin" or "user"
PRISMATIC_ROLE=admin
# The RSA private key whose public key you uploaded to Prismatic.
PRISMATIC_SIGNING_KEY_PATH=./prismatic-private-key.pem
