{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "root": false,
  "extends": ["../../biome.jsonc"],
  "files": {
    "includes": ["!**/dist", "!**/node_modules"]
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**/*.test-d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
