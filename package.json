{
  "name": "embedded-monorepo",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter @prismatic-io/embedded test",
    "test:browser": "bun run --filter @prismatic-io/embedded test:browser",
    "format": "bun run --filter './packages/*' format",
    "format:check": "bun run --filter './packages/*' format:check",
    "lint": "bun run --filter './packages/*' lint",
    "check": "bun run --filter './packages/*' check",
    "typecheck:compat": "bun run --filter @prismatic-io/embedded typecheck:compat",
    "knip": "bun run --filter './packages/*' knip",
    "publint": "bun run --filter './packages/*' publint",
    "attw": "bun run --filter './packages/*' attw",
    "agadoo": "bun run --filter @prismatic-io/embedded agadoo",
    "agadoo:solis": "bun run --filter './packages/solis-*' agadoo",
    "size-limit": "bun run --filter './packages/*' size-limit",
    "typecheck": "bun run --filter './packages/*' typecheck"
  }
}
